# Server Port
PORT=3001

# Google Gemini API Key for AI Academic Advisor
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Firebase Configuration (Vite needs VITE_ prefix to expose to client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin Configuration (For backend)
# Provide the path to the downloaded service account json, OR stringify it
FIREBASE_SERVICE_ACCOUNT_KEY=
